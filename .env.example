# Copy to .env. Never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Start without telemetry; change to 1 for Phase 2.
DD_LLMOBS_ENABLED=0
DD_LLMOBS_ML_APP=study-buddy
DD_API_KEY=
# The supplied dashboard screenshot is hosted on US5.
DD_SITE=us5.datadoghq.com
DD_SERVICE=study-buddy
DD_ENV=local
DD_VERSION=0.1.0

# Without a local Datadog Agent: LLM visibility only, no APM correlation.
DD_LLMOBS_AGENTLESS_ENABLED=1
# Explicit standalone LLM mode. Set to 1 when testing APM correlation.
DD_APM_TRACING_ENABLED=0
# With an Agent configured for APM + LLM Observability, set the above to 0.
# DD_TRACE_AGENT_URL=http://127.0.0.1:8126
